06_105356.jpg","photos/2026-08-06/20260806_105458.jpg"]},{"folder":"photos/2026-08-06","cluster_idx":1,"centroid_lat":57.859481,"centroid_lon":14.281963,"time_start":"2026-08-06T11:54:48.000Z","time_end":"2026-08-06T11:54:48.000Z","location_label":"Kaxholmen","place_full":"Bosgård, Kaxholmen, Jönköpings kommun, Jönköpings län, 561 92, Sverige","country":"Sverige","overview-description":"A small lakeside vineyard near Kaxholmen, its vines strung along wire trellises in front of traditional red Falu-red farm buildings on the shore of Lake Vättern.","multimedia_files":["photos/2026-08-06/20260806_115448.jpg"]},{"folder":"photos/2026-08-06","cluster_idx":2,"centroid_lat":58.022566,"centroid_lon":14.467676,"time_start":"2026-08-06T12:53:33.000Z","time_end":"2026-08-06T12:54:50.000Z","location_label":"Lergränd, Gränna","place_full":"Lergränd, Norra Boarp, Gränna, Jönköpings kommun, Jönköpings län, 563 32, Sverige","country":"Sverige","overview-description":"Gränna's main street and town square, known for its polkagris candy, gelato, and the Grenna Bluegrass Festival, its square flying a colorful run of international flags against the rock cliff and yellow wooden houses behind it.","multimedia_files":["photos/2026-08-06/20260806_125333.jpg","photos/2026-08-06/20260806_125450.jpg"]},{"folder":"photos/2026-08-06","cluster_idx":3,"centroid_lat":58.278755,"centroid_lon":14.635029,"time_start":"2026-08-06T14:04:46.000Z","time_end":"2026-08-06T14:05:59.000Z","location_label":"Hamngatan, Hästholmen","place_full":"Hamngatan, Tägneby, Västra Tollstad, Hästholmen, Ödeshögs kommun, Östergötlands län, 599 39, Sverige","country":"Sverige","overview-description":"A stop at Hästholmen on Lake Vättern, pairing a quiet swimming cove with wading swimmers against a rocky, pine-covered point and the small harbor's boat-lined quay under a darkening, storm-clouded sky.","multimedia_files":["photos/2026-08-06/20260806_140446.jpg","photos/2026-08-06/20260806_140559.jpg"]},{"folder":"photos/2026-08-06","cluster_idx":4,"centroid_lat":58.279806,"centroid_lon":14.634806,"time_start":"2026-08-06T14:12:55.000Z","time_end":"2026-08-06T14:15:57.000Z","location_label":"Hamngatan, Hästholmen","place_full":"Hamngatan, Tägneby, Västra Tollstad, Hästholmen, Ödeshögs kommun, Östergötlands län, 599 39, Sverige","country":"Sverige","overview-description":"A series of open, wind-swept views across Lake Vättern from Hästholmen's rocky breakwater and grassy bluff, taking in gulls on the rocks, a distant wooded shoreline, the harbor entrance with its stone breakwater and moored sailboat, and portraits of the traveler against the water under heavy summer cloud.","multimedia_files":["photos/2026-08-06/20260806_141255.jpg","photos/2026-08-06/20260806_141301.jpg","photos/2026-08-06/20260806_141314.jpg","photos/2026-08-06/20260806_141427.jpg","photos/2026-08-06/20260806_141455.jpg","photos/2026-08-06/20260806_141557.jpg"]},{"folder":"photos/2026-08-06","cluster_idx":5,"centroid_lat":58.317302,"centroid_lon":14.629438,"time_start":"2026-08-06T14:55:02.000Z","time_end":"2026-08-06T14:55:18.000Z","location_label":"Norra Sjövägen, Ödeshögs kommun","place_full":"Norra Sjövägen, Västra Tollstad, Ödeshögs kommun, Östergötlands län, 599 93, Sverige","country":"Sverige","overview-description":"A wooded overlook along Lake Vättern in Ödeshögs kommun, pine branches framing the water and a distant wind farm on the hazy far shore, with a quiet tree-lined path connecting it to the next viewpoint.","multimedia_files":["photos/2026-08-06/20260806_145502.jpg","photos/2026-08-06/20260806_145518.jpg"]},{"folder":"photos/2026-08-06","cluster_idx":6,"centroid_lat":58.319398,"centroid_lon":14.631012,"time_start":"2026-08-06T14:57:12.000Z","time_end":"2026-08-06T14:57:16.000Z","location_label":"Norra Sjövägen, Ödeshögs kommun","place_full":"Norra Sjövägen, Västra Tollstad, Ödeshögs kommun, Östergötlands län, 599 93, Sverige","country":"Sverige","overview-description":"A second, similarly framed overlook of Lake Vättern in Ödeshögs kommun, trees and a lone foreground pine giving way to farmland and a shoreline fading into haze.","multimedia_files":["photos/2026-08-06/20260806_145712.jpg","photos/2026-08-06/20260806_145716.jpg"]},{"folder":"photos/2026-08-06","cluster_idx":7,"centroid_lat":58.382894,"centroid_lon":14.686155,"time_start":"2026-08-06T15:12:37.000Z","time_end":"2026-08-06T15:16:49.000Z","location_label":"Borghamnsvägen, Borghamn","place_full":"Borghamnsvägen, Rogslösa, Borghamn, Vadstena kommun, Östergötlands län, 592 93, Sverige","country":"Sverige","overview-description":"Borghamn's legacy of centuries-old limestone quarrying is on display in a storage yard stacked with numbered stone blocks, while nearby cattle graze in a wooded pasture beside signage for the \"Runt Vättern\" cycling route.","multimedia_files":["photos/2026-08-06/20260806_151237.jpg","photos/2026-08-06/20260806_151645.jpg","photos/2026-08-06/20260806_151648.jpg"]},{"folder":"photos/2026-08-06","cluster_idx":8,"centroid_lat":58.381973,"centroid_lon":14.681875,"time_start":"2026-08-06T15:13:29.000Z","time_end":"2026-08-06T15:14:46.000Z","location_label":"Borghamnsvägen, Borghamn","place_full":"Borghamnsvägen, Rogslösa, Borghamn, Vadstena kommun, Östergötlands län, 592 93, Sverige","country":"Sverige","overview-description":"Borghamn Strand's working-life museum, its welcome sign recounting a thousand years of local limestone quarrying, with a former quarry-workers' barracks now repurposed as part of the hostel and museum complex.","multimedia_files":["photos/2026-08-06/20260806_151329.jpg","photos/2026-08-06/20260806_151446.jpg"]},{"folder":"photos/2026-08-07","cluster_idx":0,"centroid_lat":56.462456,"centroid_lon":13.633504,"time_start":"2026-08-07T10:45:02.000Z","time_end":"2026-08-07T11:29:18.000Z","location_label":"Smålandet Älgsafari, Markaryd","place_full":"Smålandet Älgsafari, E 4, Misterhult, Markaryd, Markaryds kommun, Kronobergs län, 285 93, Sverige","country":"Sverige","overview-description":"After a stray pocket shot, the day's outing turns up a pair of moose in a shaded clearing, one grazing on tall grass and glancing toward the camera while its companion rests nearby.","multimedia_files":["photos/2026-08-07/20260807_104502_001.jpg","photos/2026-08-07/20260807_112853.jpg","photos/2026-08-07/20260807_112900.jpg","photos/2026-08-07/20260807_112918.jpg"]},{"folder":"photos/2026-08-07","cluster_idx":1,"centroid_lat":56.464116,"centroid_lon":13.635304,"time_start":"2026-08-07T10:56:01.000Z","time_end":"2026-08-07T11:18:40.000Z","location_label":"Smålandet Älgsafari, Markaryd","place_full":"Smålandet Älgsafari, 15, Fjärholma, Markaryd, Markaryds kommun, Kronobergs län, 285 93, Sverige","country":"Sverige","overview-description":"An extended visit to a Swedish moose park, getting close encounters with velvet-antlered bull moose that graze unbothered beside cars, poke their heads into windows, walk through the grass toward the camera, and rest beneath low branches amid the birch and spruce enclosure.","multimedia_files":["photos/2026-08-07/20260807_105600.jpg","photos/2026-08-07/20260807_105653.jpg","photos/2026-08-07/20260807_105724.jpg","photos/2026-08-07/20260807_105731.jpg","photos/2026-08-07/20260807_105745.jpg","photos/2026-08-07/20260807_105752.jpg","photos/2026-08-07/20260807_110004.jpg","photos/2026-08-07/20260807_111639.jpg","photos/2026-08-07/20260807_111830.jpg","photos/2026-08-07/20260807_111840.jpg"]},{"folder":"photos/2026-08-07","cluster_idx":2,"centroid_lat":56.463086,"centroid_lon":13.634593,"time_start":"2026-08-07T11:23:56.000Z","time_end":"2026-08-07T11:23:56.000Z","location_label":"Smålandet Älgsafari, Markaryd","place_full":"Smålandet Älgsafari, E 4, Misterhult, Markaryd, Markaryds kommun, Kronobergs län, 285 93, Sverige","country":"Sverige","overview-description":"Two moose rest together in dappled shade, one lifting its head to watch passing visitors.","multimedia_files":["photos/2026-08-07/20260807_112356.jpg"]},{"f